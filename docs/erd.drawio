ign=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_BOOKING"><mxGeometry y="708" width="560" height="58" as="geometry"/></mxCell><mxCell id="E_INVOICE" value="INVOICE" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1a1a1a;swimlaneFillColor=#f8cecc;" vertex="1" parent="1"><mxGeometry x="600" y="1610" width="500" height="392" as="geometry"/></mxCell><mxCell id="E_INVOICE_a0" value="&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;invoiceId&lt;/b&gt; : String&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính, do người thiết kế cấp: I001…I012&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="34" width="500" height="42" as="geometry"/></mxCell><mxCell id="E_INVOICE_a1" value="&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;bookingId&lt;/b&gt; : String → BOOKING&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Một lượt đặt sinh ra tối đa một hóa đơn&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="76" width="500" height="42" as="geometry"/></mxCell><mxCell id="E_INVOICE_a2" value="&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;customerId&lt;/b&gt; : String → CUSTOMER&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Lưu trùng khách để lập báo cáo mà không cần join&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="118" width="500" height="58" as="geometry"/></mxCell><mxCell id="E_INVOICE_a3" value="&lt;b&gt;FK&lt;/b&gt; &lt;b&gt;fieldId&lt;/b&gt; : String → SPORTFIELD&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Lưu trùng sân để lập báo cáo mà không cần join&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="176" width="500" height="58" as="geometry"/></mxCell><mxCell id="E_INVOICE_a4" value="&lt;b&gt;issueDate&lt;/b&gt; : LocalDate&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Ngày phát hành hóa đơn, ví dụ: 15/02/2026&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="234" width="500" height="42" as="geometry"/></mxCell><mxCell id="E_INVOICE_a5" value="&lt;b&gt;status&lt;/b&gt; : Enum InvoiceStatus&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;PAID (đã trả) · UNPAID (chưa trả) · REFUNDED (đã hoàn tiền)&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="276" width="500" height="58" as="geometry"/></mxCell><mxCell id="E_INVOICE_a6" value="&lt;b&gt;amount&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Chụp lại totalAmount của lượt đặt tại lúc phát hành&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_INVOICE"><mxGeometry y="334" width="500" height="58" as="geometry"/></mxCell><mxCell id="H1" value="Kế thừa — sân bóng đá   —   1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=10;fontColor=#b37400;labelBackgroundColor=#fff2cc;" edge="1" parent="1" source="E_SPORTFIELD" target="E_FOOTBALL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="H2" value="Kế thừa — sân cầu lông   —   1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=10;fontColor=#b37400;labelBackgroundColor=#fff2cc;" edge="1" parent="1" source="E_SPORTFIELD" target="E_BADMINTON"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="H3" value="Kế thừa — sân tennis   —   1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=10;fontColor=#b37400;labelBackgroundColor=#fff2cc;" edge="1" parent="1" source="E_SPORTFIELD" target="E_TENNIS"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="H4" value="Kế thừa — sân pickleball   —   1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=10;fontColor=#b37400;labelBackgroundColor=#fff2cc;" edge="1" parent="1" source="E_SPORTFIELD" target="E_PICKLEBALL"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="R1" value="Khách đặt sân   —   1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#4d4d4d;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E_CUSTOMER" target="E_BOOKING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="R2" value="Sân được đặt   —   1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#4d4d4d;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E_SPORTFIELD" target="E_BOOKING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="R3" value="Dịch vụ kèm theo (có thể không có)   —   0..1 : 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#4d4d4d;startArrow=ERzeroToOne;startFill=0;endArrow=ERmany;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E_SERVICE" target="E_BOOKING"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="R4" value="Sinh hóa đơn thanh toán   —   1 : 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1.5;strokeColor=#4d4d4d;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E_BOOKING" target="E_INVOICE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="R5" value="Dụng cụ vợt cho thuê tại sân cầu lông   —   —" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#82b366;dashed=1;endArrow=none;fontSize=10;fontColor=#5b7c3a;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="E_BADMINTON" target="E_SERVICE"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="P1_NOTE" value="&lt;b&gt;GHI CHÚ THIẾT KẾ&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. BOOKING là thực thể liên kết.&lt;/b&gt;&lt;br/&gt;Nó giải quyết quan hệ nhiều – nhiều giữa CUSTOMER và SPORTFIELD: một khách đặt được nhiều sân khác nhau, một sân phục vụ nhiều khách. Thiếu thực thể này thì quan hệ nhiều – nhiều sẽ phải tách thêm bảng trung gian.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. SERVICE là quan hệ 0..1 tương đối.&lt;/b&gt;&lt;br/&gt;Một lượt đặt &lt;i&gt;có thể&lt;/i&gt; kèm hoặc không kèm dịch vụ, nên khóa ngoại serviceId cho phép null, không đặt ràng buộc bắt buộc.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. INVOICE lưu giá trị chụp (snapshot).&lt;/b&gt;&lt;br/&gt;customerId, fieldId và amount được sao chép sang lúc phát hành. Nhờ vậy báo cáo doanh thu theo khách hay theo sân không phải join ngược lại BOOKING, và kết quả không bị đổi khi lượt đặt sửa về sau.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. Bốn bảng loại sân không có quan hệ với nhau.&lt;/b&gt;&lt;br/&gt;Một sân chỉ thuộc đúng một loại, nên tồn tại nhiều nhất một bản ghi trong một trong bốn bảng này. Đây chính là cách biểu diễn quan hệ &lt;b&gt;kế thừa&lt;/b&gt; trong mô hình quan hệ, đối xứng với thừa kế lớp trong Java.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. Các cột calc không tồn tại trong cơ sở dữ liệu.&lt;/b&gt;&lt;br/&gt;MIS hoàn chỉnh sẽ tách thành bảng phụ hoặc tính bằng view. Ở đồ án này công thức được giữ trong lớp Java và kiểm chứng bằng 64 phép thử tự động — đúng nguyên tắc tính theo nguồn sự kiện." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1380" y="300" width="480" height="560" as="geometry"/></mxCell><mxCell id="P1_DATA" value="&lt;b&gt;QUY MÔ DỮ LIỆU MẪU CHO CÁC THỰC THỂ&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;CUSTOMER — 6 khách&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;3 khách STANDARD và 3 khách VIP&lt;br/&gt;&lt;br/&gt;&lt;b&gt;SPORTFIELD — 6 sân&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;2 sân bóng đá, 2 sân cầu lông,&lt;br/&gt;&amp;nbsp;&amp;nbsp;1 sân tennis, 1 sân pickleball&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ chia đều vào 4 bảng loại sân&lt;br/&gt;&lt;br/&gt;&lt;b&gt;SERVICE — 6 dịch vụ&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;có 1 dịch vụ đang tạm ngưng&lt;br/&gt;&lt;br/&gt;&lt;b&gt;BOOKING — 12 lượt đặt&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;đủ ba trạng thái, có lượt vào&lt;br/&gt;&amp;nbsp;&amp;nbsp;giờ cao điểm lẫn ngoài giờ cao&lt;br/&gt;&amp;nbsp;&amp;nbsp;điểm, có lượt không kèm dịch vụ&lt;br/&gt;&lt;br/&gt;&lt;b&gt;INVOICE — 12 hóa đơn&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;6 đã trả, 4 chưa trả, 2 đã hoàn" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1380" y="890" width="480" height="380" as="geometry"/></mxCell><mxCell id="P1_RULE" value="&lt;b&gt;QUY TẮC XÁC ĐỊNH KHÓA&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Khóa chính của cả chín bảng đều là &lt;b&gt;khóa tự nhiên do người thiết kế cấp&lt;/b&gt;, theo quy ước: chữ cái viết tắt của thực thể ghép ba chữ số — C001, F001, SV001, B001, I001.&lt;br/&gt;&lt;br/&gt;• Khóa &lt;b&gt;không&lt;/b&gt; sinh tự động bởi hệ thống, để khi trình diễn chỉ cần chạy chương trình là có ngay bộ dữ liệu.&lt;br/&gt;&lt;br/&gt;• Bốn bảng loại sân dùng chung &lt;b&gt;fieldId&lt;/b&gt; làm khóa chính lẫn khóa ngoại trỏ về SPORTFIELD. Nhờ vậy một sân không thể xuất hiện ở hai bảng loại sân cùng lúc.&lt;br/&gt;&lt;br/&gt;• Khóa ngoại không lặp lại thuộc tính mô tả: BOOKING không lưu customerName mà chỉ lưu customerId, nên không bao giờ xảy ra chuyện tên khách trong lượt đặt khác tên trong hồ sơ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1380" y="1300" width="480" height="380" as="geometry"/></mxCell><mxCell id="P1_IDX" value="&lt;b&gt;GỢI Ý THỰC HIỆN KHI MỞ RỘNG HỆ THỐNG&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Đây là các khuyến nghị vận hành, &lt;b&gt;không&lt;/b&gt; đưa vào ERD vì không phải thuộc tính của thực thể:&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. Chỉ mục (index)&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• BOOKING(status, startTime) — phục vụ các truy vấn thống kê theo trạng thái và theo ngày.&lt;br/&gt;&amp;nbsp;&amp;nbsp;• BOOKING(customerId) và BOOKING(fieldId) — phục vụ truy vấn theo khách và theo sân.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. Ràng buộc nghiệp vụ&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• endTime phải lớn hơn startTime.&lt;br/&gt;&amp;nbsp;&amp;nbsp;• Hai lượt đặt của cùng một sân không được trùng khung giờ.&lt;br/&gt;&amp;nbsp;&amp;nbsp;• Không cho đặt sân khi status = MAINTENANCE.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. Bảo mật dữ liệu&lt;/b&gt;&lt;br/&gt;&amp;nbsp;&amp;nbsp;• Không nhập trùng customerId, fieldId, serviceId, bookingId, invoiceId.&lt;br/&gt;&amp;nbsp;&amp;nbsp;• Khi xóa một lượt đặt đã phát hành hóa đơn thì phải từ chối thao tác xóa." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1380" y="1710" width="480" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="d2" name="2. ER → Lớp Java OOP"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="2200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P2_TITLE" value="CHUYỂN CÁC QUAN HỆ ER / RR THÀNH CÁC LỚP TRONG PROJECT JAVA" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="45" width="1600" height="46" as="geometry"/></mxCell><mxCell id="P2_SUB" value="Bước 2 của đặc tả. Chín bảng trong ERD trở thành mười một lớp thực thể trong thư mục &lt;b&gt;src/smartsporthub/model&lt;/b&gt; của project IntelliJ IDEA. Bảng ánh xạ bên dưới là bản đối chiếu giữa hai hình thức tổ chức dữ liệu của cùng một nghiệp vụ." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontColor=#444444;lineHeight=1.35;" vertex="1" parent="1"><mxGeometry x="60" y="95" width="1600" height="60" as="geometry"/></mxCell><mxCell id="T1" value="&lt;b&gt;Bảng ER → một lớp&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Tên lớp viết hoa chữ cái đầu, không dấu gạch.&lt;br/&gt;Đặt trong thư mục &lt;b&gt;model/&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="560" height="150" as="geometry"/></mxCell><mxCell id="T2" value="&lt;b&gt;Quan hệ RR → tham chiếu&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Không tạo bảng liên kết riêng.&lt;br/&gt;Lớp giữ &lt;b&gt;thuộc tính tham chiếu&lt;/b&gt; tới lớp kia." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="650" y="165" width="560" height="150" as="geometry"/></mxCell><mxCell id="T3" value="&lt;b&gt;Thuộc tính khóa → bất biến&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Khai báo &lt;b&gt;private final&lt;/b&gt;.&lt;br/&gt;Không có hàm thiết lập cho thuộc tính khóa." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1240" y="165" width="560" height="150" as="geometry"/></mxCell><mxCell id="T4" value="&lt;b&gt;Thuộc tính enum → java enum&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Tách thành &lt;b&gt;kiểu enum&lt;/b&gt; trong model/.&lt;br/&gt;Dùng để kiểm tra giá trị hợp lệ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="560" height="150" as="geometry"/></mxCell><mxCell id="T5" value="&lt;b&gt;Quan hệ kế thừa → lớp trừu tượng&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Bảng gốc thành &lt;b&gt;lớp trừu tượng&lt;/b&gt;, mỗi bảng con thành &lt;b&gt;một lớp con&lt;/b&gt; ghi đè phương thức trừu tượng." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="650" y="330" width="560" height="150" as="geometry"/></mxCell><mxCell id="T6" value="&lt;b&gt;Nhóm thao tác CRUD → lớp quản lý&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Mỗi thực thể gốc có một &lt;b&gt;manager&lt;/b&gt; riêng trong manager/, giữ danh sách kiểu List." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1240" y="330" width="560" height="150" as="geometry"/></mxCell><mxCell id="P2_M_TITLE" value="BẢNG ÁN XẠC: 9 BẢNG ER  →  15 LỚP JAVA" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="1600" height="32" as="geometry"/></mxCell><mxCell id="M1a" value="&lt;b&gt;CUSTOMER&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="570" width="300" height="78" as="geometry"/></mxCell><mxCell id="M1b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="570" width="60" height="78" as="geometry"/></mxCell><mxCell id="M1c" value="Customer (trừu tượng)&lt;br/&gt;StandardCustomer · VipCustomer" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="570" width="420" height="78" as="geometry"/></mxCell><mxCell id="M1d" value="Một bảng sinh ra &lt;b&gt;một lớp trừu tượng và hai lớp con&lt;/b&gt;, vì khách hàng chia thành hai nhóm có chính sách ưu đãi khác nhau." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="570" width="780" height="78" as="geometry"/></mxCell><mxCell id="M2a" value="&lt;b&gt;SPORTFIELD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="656" width="300" height="78" as="geometry"/></mxCell><mxCell id="M2b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="656" width="60" height="78" as="geometry"/></mxCell><mxCell id="M2c" value="SportField (trừu tượng)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="656" width="420" height="78" as="geometry"/></mxCell><mxCell id="M2d" value="Chỉ một lớp trừu tượng, &lt;b&gt;không có lớp con trực tiếp&lt;/b&gt; — các lớp con nằm ở bốn bảng loại sân bên dưới." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="656" width="780" height="78" as="geometry"/></mxCell><mxCell id="M3a" value="&lt;b&gt;FOOTBALL_FIELD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="742" width="300" height="78" as="geometry"/></mxCell><mxCell id="M3b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="742" width="60" height="78" as="geometry"/></mxCell><mxCell id="M3c" value="FootballField" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="742" width="420" height="78" as="geometry"/></mxCell><mxCell id="M3d" value="Ghi đè calculateRentalFee() và giữ thuộc tính nightLightFee." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="742" width="780" height="78" as="geometry"/></mxCell><mxCell id="M4a" value="&lt;b&gt;BADMINTON_FIELD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="828" width="300" height="78" as="geometry"/></mxCell><mxCell id="M4b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="828" width="60" height="78" as="geometry"/></mxCell><mxCell id="M4c" value="BadmintonField" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="828" width="420" height="78" as="geometry"/></mxCell><mxCell id="M4d" value="Ghi đè calculateRentalFee() và giữ hai thuộc tính racketFee, matFee." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="828" width="780" height="78" as="geometry"/></mxCell><mxCell id="M5a" value="&lt;b&gt;TENNIS_FIELD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="914" width="300" height="78" as="geometry"/></mxCell><mxCell id="M5b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="914" width="60" height="78" as="geometry"/></mxCell><mxCell id="M5c" value="TennisField" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="914" width="420" height="78" as="geometry"/></mxCell><mxCell id="M5d" value="Ghi đè calculateRentalFee() và giữ thuộc tính courtEquipmentFee." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="914" width="780" height="78" as="geometry"/></mxCell><mxCell id="M6a" value="&lt;b&gt;PICKLEBALL_FIELD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="300" height="78" as="geometry"/></mxCell><mxCell id="M6b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="1000" width="60" height="78" as="geometry"/></mxCell><mxCell id="M6c" value="PickleballField" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="1000" width="420" height="78" as="geometry"/></mxCell><mxCell id="M6d" value="Ghi đè calculateRentalFee() và giữ thuộc tính equipmentFeePerHour." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="1000" width="780" height="78" as="geometry"/></mxCell><mxCell id="M7a" value="&lt;b&gt;SERVICE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="1086" width="300" height="78" as="geometry"/></mxCell><mxCell id="M7b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="1086" width="60" height="78" as="geometry"/></mxCell><mxCell id="M7c" value="Service" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="1086" width="420" height="78" as="geometry"/></mxCell><mxCell id="M7d" value="Là bảng đơn giản không phân loại nên chỉ cần &lt;b&gt;một lớp đơn&lt;/b&gt;, không có lớp con." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="1086" width="780" height="78" as="geometry"/></mxCell><mxCell id="M8a" value="&lt;b&gt;BOOKING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="1172" width="300" height="78" as="geometry"/></mxCell><mxCell id="M8b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="1172" width="60" height="78" as="geometry"/></mxCell><mxCell id="M8c" value="Booking" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="1172" width="420" height="78" as="geometry"/></mxCell><mxCell id="M8d" value="Lớp của thực thể liên kết, giữ &lt;b&gt;ba thuộc tính tham chiếu&lt;/b&gt;: Customer, SportField và Service — trong đó Service cho phép null." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="1172" width="780" height="78" as="geometry"/></mxCell><mxCell id="M9a" value="&lt;b&gt;INVOICE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="1258" width="300" height="78" as="geometry"/></mxCell><mxCell id="M9b" value="→" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;fontColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="375" y="1258" width="60" height="78" as="geometry"/></mxCell><mxCell id="M9c" value="Invoice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;spacing=10;fontColor=#1a1a1a;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="450" y="1258" width="420" height="78" as="geometry"/></mxCell><mxCell id="M9d" value="Giữ &lt;b&gt;một tham chiếu Booking&lt;/b&gt;, đồng thời chụp lại customerId, fieldId và amount để lập báo cáo." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1"><mxGeometry x="890" y="1258" width="780" height="78" as="geometry"/></mxCell><mxCell id="P2_E_TITLE" value="ENUM — CÁC TẬP GIÁ TRỊ RÀNG BUỘC CỦA THỰC THỂ" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="1369" width="1600" height="32" as="geometry"/></mxCell><mxCell id="EN1" value="&lt;b&gt;FieldType&lt;/b&gt;&lt;br/&gt;&lt;font color='#b85450'&gt;&lt;b&gt;FOOTBALL, BADMINTON, TENNIS, PICKLEBALL&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px' color='#666666'&gt;Cột fieldType trong bảng SPORTFIELD. Trong Java được suy ra từ kiểu lớp con, nhưng trong ERD phải lưu thành cột để thống kê được theo loại.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="1414" width="560" height="155" as="geometry"/></mxCell><mxCell id="EN2" value="&lt;b&gt;CustomerType&lt;/b&gt;&lt;br/&gt;&lt;font color='#b85450'&gt;&lt;b&gt;STANDARD, VIP&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px' color='#666666'&gt;Lớp StandardCustomer trả về STANDARD, lớp VipCustomer trả về VIP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="650" y="1414" width="560" height="155" as="geometry"/></mxCell><mxCell id="EN3" value="&lt;b&gt;FieldStatus&lt;/b&gt;&lt;br/&gt;&lt;font color='#b85450'&gt;&lt;b&gt;AVAILABLE, MAINTENANCE, OCCUPIED&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px' color='#666666'&gt;Trạng thái của sân: sẵn sàng, đang bảo trì, đang có người dùng.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1240" y="1414" width="560" height="155" as="geometry"/></mxCell><mxCell id="EN4" value="&lt;b&gt;BookingStatus&lt;/b&gt;&lt;br/&gt;&lt;font color='#b85450'&gt;&lt;b&gt;COMPLETED, CONFIRMED, CANCELLED&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px' color='#666666'&gt;Trạng thái lượt đặt. CANCELLED không tính vào doanh thu.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="1584" width="560" height="155" as="geometry"/></mxCell><mxCell id="EN5" value="&lt;b&gt;InvoiceStatus&lt;/b&gt;&lt;br/&gt;&lt;font color='#b85450'&gt;&lt;b&gt;PAID, UNPAID, REFUNDED&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px' color='#666666'&gt;Trạng thái thanh toán: đã trả, chưa trả, đã hoàn tiền.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="650" y="1584" width="560" height="155" as="geometry"/></mxCell><mxCell id="EN6" value="&lt;b&gt;ServiceCategory&lt;/b&gt;&lt;br/&gt;&lt;font color='#b85450'&gt;&lt;b&gt;NƯỚC, THIẾT_BỊ, DỊCH_VỤ, TIỆC_CƯ_TRANG, TIỆN_ÍCH&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px' color='#666666'&gt;Nhóm dịch vụ dùng để lọc, ví dụ nhóm THIẾT_BỊ phục vụ truy vấn tìm khách dùng vợt nhưng chưa từng đặt sân tennis.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="1240" y="1584" width="560" height="155" as="geometry"/></mxCell><mxCell id="P2_I" value="&lt;b&gt;INTERFACE — TÁCH PHẦN MỞ RỘNG CHO LẬP TRÌNH HƯỚNG ĐỐI TƯỢNG&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IPromotional&lt;/b&gt; — do lớp Customer hiện thực&lt;br/&gt;&amp;nbsp;&amp;nbsp;• calculatePromotionalDiscount(double amount) : double&lt;br/&gt;&amp;nbsp;&amp;nbsp;• getPromotionPolicy() : String&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ Lớp StandardCustomer luôn trả về 0.0; lớp VipCustomer trả về tỷ lệ giảm lấy từ thuộc tính của chính mình.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IPeakHourCalculable&lt;/b&gt; — do bốn lớp con của SportField hiện thực&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ Lớp Booking chỉ cộng phí cao điểm khi kiểm tra &lt;i&gt;field instanceof IPeakHourCalculable&lt;/i&gt;.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ý nghĩa thiết kế:&lt;/b&gt; tách phần biến động (khách VIP giảm giá, loại sân tính phí cao điểm) ra khỏi phần cố định. Thêm một loại sân mới hoặc một hạng khách mới chỉ cần viết thêm một lớp con, không phải sửa lại những lớp đang chạy tốt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="60" y="1759" width="800" height="350" as="geometry"/></mxCell><mxCell id="P2_C" value="&lt;b&gt;CÔNG THỨC TÍNH PHÍ — Lớp FieldPricing (final, hàm khởi tạo private)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Khung giờ cao điểm:&lt;/b&gt; PEAK_START = 17:00 &amp;nbsp;|&amp;nbsp; PEAK_END = 20:00 &amp;nbsp;|&amp;nbsp; PEAK_SURCHARGE_RATE = 0.20&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Phí riêng theo loại sân:&lt;/b&gt;&lt;br/&gt;FOOTBALL_NIGHT_LIGHT_FEE = 50.000&lt;br/&gt;BADMINTON_RACKET_FEE = 20.000 &amp;nbsp;|&amp;nbsp; BADMINTON_MAT_FEE = 10.000&lt;br/&gt;TENNIS_EQUIPMENT_FEE = 40.000 &amp;nbsp;|&amp;nbsp; PICKLEBALL_EQUIPMENT_FEE_PER_HOUR = 15.000&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Công thức ghi đè trong từng lớp con:&lt;/b&gt;&lt;br/&gt;Sân bóng đá &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= basePricePerHour × giờ + 50.000&lt;br/&gt;Sân cầu lông = basePricePerHour × giờ + 20.000 + 10.000&lt;br/&gt;Sân tennis &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= basePricePerHour × giờ + 40.000&lt;br/&gt;Sân pickleball = (basePricePerHour + 15.000) × giờ&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Phí cao điểm&lt;/b&gt; = basePricePerHour × giờ × 0.20, chỉ áp dụng khi 17:00 ≤ giờ bắt đầu &amp;lt; 20:00&lt;br/&gt;&lt;b&gt;Tổng tiền&lt;/b&gt; = phí thuê sân + phí cao điểm + phí dịch vụ − ưu đãi&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ví dụ kiểm chứng&lt;/b&gt; (lượt đặt B001, khách VIP giảm 10%):&lt;br/&gt;200.000 + 40.000 + 30.000 − 27.000 = &lt;b&gt;243.000 đồng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1"><mxGeometry x="900" y="1759" width="770" height="350" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>