<mxfile host="app.diagrams.net" agent="hermes-smartsporthub-spec" version="24.7.17" type="device"><diagram id="d1" name="1. ERD"><mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="2150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="P1_TITLE" value="SMARTSPORTHUB — SƠ ĐỒ QUAN HỆ THỰC THỂ (ERD)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="60" y="55" width="1800" height="46" as="geometry"/></mxCell><mxCell id="P1_SUB" value="Môn OOPR240279 — Lập trình hướng đối tượng. Đặc tả dự án nhóm gồm: phát biểu vấn đề, xác định các thực thể, xác định thuộc tính khóa và thuộc tính mô tả, xác định mối liên kết, rồi xây dựng ERD.&lt;br/&gt;&lt;b&gt;Cấu trúc ERD:&lt;/b&gt; 5 bảng thực thể gốc (SPORTFIELD, CUSTOMER, SERVICE, BOOKING, INVOICE) và 4 bảng loại sân nối bằng quan hệ kế thừa — mỗi bảng loại sân ứng với đúng một lớp con trong Java.&lt;br/&gt;&lt;b&gt;Ký hiệu:&lt;/b&gt; &amp;nbsp; &lt;b&gt;PK&lt;/b&gt; thuộc tính khóa chính &amp;nbsp;·&amp;nbsp; &lt;b&gt;FK&lt;/b&gt; khóa ngoại &amp;nbsp;·&amp;nbsp; &lt;b&gt;PK, FK&lt;/b&gt; vừa là khóa chính vừa là khóa ngoại &amp;nbsp;·&amp;nbsp; &lt;b&gt;calc&lt;/b&gt; thuộc tính tính toán, không lưu trong bảng &amp;nbsp;·&amp;nbsp; cặp số &lt;b&gt;1 : 0..N&lt;/b&gt; cho biết số lượng tối thiểu và tối đa ở mỗi vế quan hệ &amp;nbsp;·&amp;nbsp; đường nét đứt màu cam là quan hệ kế thừa." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontColor=#444444;lineHeight=1.35;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="1800" height="110" as="geometry"/></mxCell><mxCell id="E_SPORTFIELD" value="SPORTFIELD" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;swimlaneFillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="430" height="276" as="geometry"/></mxCell><mxCell id="E_SPORTFIELD_a0" value="&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;fieldId&lt;/b&gt; : String&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính, do người thiết kế cấp: F001…F006&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_SPORTFIELD"><mxGeometry y="34" width="430" height="42" as="geometry"/></mxCell><mxCell id="E_SPORTFIELD_a1" value="&lt;b&gt;fieldName&lt;/b&gt; : String&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Tên sân, ví dụ: Sân bóng A&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_SPORTFIELD"><mxGeometry y="76" width="430" height="42" as="geometry"/></mxCell><mxCell id="E_SPORTFIELD_a2" value="&lt;b&gt;fieldType&lt;/b&gt; : Enum FieldType&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;FOOTBALL · BADMINTON · TENNIS · PICKLEBALL — cột bắt buộc để thống kê theo loại&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_SPORTFIELD"><mxGeometry y="118" width="430" height="58" as="geometry"/></mxCell><mxCell id="E_SPORTFIELD_a3" value="&lt;b&gt;basePricePerHour&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Giá thuê một giờ: 60.000 – 150.000 đồng&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_SPORTFIELD"><mxGeometry y="176" width="430" height="42" as="geometry"/></mxCell><mxCell id="E_SPORTFIELD_a4" value="&lt;b&gt;status&lt;/b&gt; : Enum FieldStatus&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;AVAILABLE (sẵn sàng) · MAINTENANCE (bảo trì) · OCCUPIED (đang dùng)&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_SPORTFIELD"><mxGeometry y="218" width="430" height="58" as="geometry"/></mxCell><mxCell id="E_FOOTBALL" value="FOOTBALL_FIELD" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;swimlaneFillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="540" y="300" width="350" height="134" as="geometry"/></mxCell><mxCell id="E_FOOTBALL_a0" value="&lt;b&gt;PK, FK&lt;/b&gt; &lt;b&gt;fieldId&lt;/b&gt; : String → SPORTFIELD&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính đồng thời là khóa ngoại — quan hệ kế thừa 0..1&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_FOOTBALL"><mxGeometry y="34" width="350" height="58" as="geometry"/></mxCell><mxCell id="E_FOOTBALL_a1" value="&lt;b&gt;nightLightFee&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Phí đèn 50.000 đồng cho mỗi lượt thuê&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_FOOTBALL"><mxGeometry y="92" width="350" height="42" as="geometry"/></mxCell><mxCell id="E_BADMINTON" value="BADMINTON_FIELD" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;swimlaneFillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="940" y="300" width="390" height="160" as="geometry"/></mxCell><mxCell id="E_BADMINTON_a0" value="&lt;b&gt;PK, FK&lt;/b&gt; &lt;b&gt;fieldId&lt;/b&gt; : String → SPORTFIELD&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính và khóa ngoại — kế thừa 0..1&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_BADMINTON"><mxGeometry y="34" width="390" height="42" as="geometry"/></mxCell><mxCell id="E_BADMINTON_a1" value="&lt;b&gt;racketFee&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Phí thuê vợt 20.000 đồng mỗi lượt&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_BADMINTON"><mxGeometry y="76" width="390" height="42" as="geometry"/></mxCell><mxCell id="E_BADMINTON_a2" value="&lt;b&gt;matFee&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Phí thảm 10.000 đồng mỗi lượt&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_BADMINTON"><mxGeometry y="118" width="390" height="42" as="geometry"/></mxCell><mxCell id="E_TENNIS" value="TENNIS_FIELD" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;swimlaneFillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="350" height="118" as="geometry"/></mxCell><mxCell id="E_TENNIS_a0" value="&lt;b&gt;PK, FK&lt;/b&gt; &lt;b&gt;fieldId&lt;/b&gt; : String → SPORTFIELD&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính và khóa ngoại — kế thừa 0..1&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_TENNIS"><mxGeometry y="34" width="350" height="42" as="geometry"/></mxCell><mxCell id="E_TENNIS_a1" value="&lt;b&gt;courtEquipmentFee&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Phí dụng cụ 40.000 đồng mỗi lượt&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_TENNIS"><mxGeometry y="76" width="350" height="42" as="geometry"/></mxCell><mxCell id="E_PICKLEBALL" value="PICKLEBALL_FIELD" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;swimlaneFillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="940" y="490" width="390" height="118" as="geometry"/></mxCell><mxCell id="E_PICKLEBALL_a0" value="&lt;b&gt;PK, FK&lt;/b&gt; &lt;b&gt;fieldId&lt;/b&gt; : String → SPORTFIELD&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính và khóa ngoại — kế thừa 0..1&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_PICKLEBALL"><mxGeometry y="34" width="390" height="42" as="geometry"/></mxCell><mxCell id="E_PICKLEBALL_a1" value="&lt;b&gt;equipmentFeePerHour&lt;/b&gt; : double&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Phí dụng cụ 15.000 đồng cho mỗi giờ thuê&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_PICKLEBALL"><mxGeometry y="76" width="390" height="42" as="geometry"/></mxCell><mxCell id="E_CUSTOMER" value="CUSTOMER" style="swimlane;fontStyle=1;childLayout=tableLayout;startSize=34;horizontal=1;rounded=1;arcSize=6;collapsible=0;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;swimlaneFillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="460" height="360" as="geometry"/></mxCell><mxCell id="E_CUSTOMER_a0" value="&lt;b&gt;PK&lt;/b&gt; &lt;b&gt;customerId&lt;/b&gt; : String&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Khóa chính, do người thiết kế cấp: C001…C006&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontColor=default;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rounded=0;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" connectable="0" parent="E_CUSTOMER"><mxGeometry y="34" width="460" height="42" as="geometry"/></mxCell><mxCell id="E_CUSTOMER_a1" value="&lt;b&gt;fullName&lt;/b&gt; : String&lt;br/&gt;&lt;font style='font-size:9px' color='#666666'&gt;Họ và tên khách hàng&lt;/font&gt;" style="shape=partialRectangle;collapsible=0;dropTarget=0;pointerEvents=0;fillColor=none;top=0