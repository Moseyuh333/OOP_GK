        <mxCell id="M9d" value="Giữ &lt;b&gt;một tham chiếu Booking&lt;/b&gt;, đồng thời chụp lại customerId, fieldId và amount để lập báo cáo." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1">
          <mxGeometry x="890" y="1258" width="780" height="78" as="geometry" />
