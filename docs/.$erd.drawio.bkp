        <mxCell id="M2d" value="Chỉ một lớp trừu tượng, &lt;b&gt;không có lớp con trực tiếp&lt;/b&gt; — các lớp con nằm ở bốn bảng loại sân bên dưới." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#444444;lineHeight=1.3;" vertex="1" parent="1">
