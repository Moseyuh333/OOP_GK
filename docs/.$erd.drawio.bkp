        <mxCell id="P2_E_TITLE" value="ENUM — CÁC TẬP GIÁ TRỊ RÀNG BUỘC CỦA THỰC THỂ" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="1369" width="1600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="EN1" value="&lt;b&gt;FieldType&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#b85450&#39;&gt;&lt;b&gt;FOOTBALL, BADMINTON, TENNIS, PICKLEBALL&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;Cột fieldType trong bảng SPORTFIELD. Trong Java được suy ra từ kiểu lớp con, nhưng trong ERD phải lưu thành cột để thống kê được theo loại.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1414" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="EN2" value="&lt;b&gt;CustomerType&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#b85450&#39;&gt;&lt;b&gt;STANDARD, VIP&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;Lớp StandardCustomer trả về STANDARD, lớp VipCustomer trả về VIP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="650" y="1414" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="EN3" value="&lt;b&gt;FieldStatus&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#b85450&#39;&gt;&lt;b&gt;AVAILABLE, MAINTENANCE, OCCUPIED&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;Trạng thái của sân: sẵn sàng, đang bảo trì, đang có người dùng.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1414" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="EN4" value="&lt;b&gt;BookingStatus&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#b85450&#39;&gt;&lt;b&gt;COMPLETED, CONFIRMED, CANCELLED&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;Trạng thái lượt đặt. CANCELLED không tính vào doanh thu.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1584" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="EN5" value="&lt;b&gt;InvoiceStatus&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#b85450&#39;&gt;&lt;b&gt;PAID, UNPAID, REFUNDED&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;Trạng thái thanh toán: đã trả, chưa trả, đã hoàn tiền.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="650" y="1584" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="EN6" value="&lt;b&gt;ServiceCategory&lt;/b&gt;&lt;br/&gt;&lt;font color=&#39;#b85450&#39;&gt;&lt;b&gt;NƯỚC, THIẾT_BỊ, DỊCH_VỤ, TIỆC_CƯ_TRANG, TIỆN_ÍCH&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#666666&#39;&gt;Nhóm dịch vụ dùng để lọc, ví dụ nhóm THIẾT_BỊ phục vụ truy vấn tìm khách dùng vợt nhưng chưa từng đặt sân tennis.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;spacing=10;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="1584" width="560" height="155" as="geometry" />
        </mxCell>
        <mxCell id="P2_I" value="&lt;b&gt;INTERFACE — TÁCH PHẦN MỞ RỘNG CHO LẬP TRÌNH HƯỚNG ĐỐI TƯỢNG&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IPromotional&lt;/b&gt; — do lớp Customer hiện thực&lt;br/&gt;&amp;nbsp;&amp;nbsp;• calculatePromotionalDiscount(double amount) : double&lt;br/&gt;&amp;nbsp;&amp;nbsp;• getPromotionPolicy() : String&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ Lớp StandardCustomer luôn trả về 0.0; lớp VipCustomer trả về tỷ lệ giảm lấy từ thuộc tính của chính mình.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;IPeakHourCalculable&lt;/b&gt; — do bốn lớp con của SportField hiện thực&lt;br/&gt;&amp;nbsp;&amp;nbsp;→ Lớp Booking chỉ cộng phí cao điểm khi kiểm tra &lt;i&gt;field instanceof IPeakHourCalculable&lt;/i&gt;.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ý nghĩa thiết kế:&lt;/b&gt; tách phần biến động (khách VIP giảm giá, loại sân tính phí cao điểm) ra khỏi phần cố định. Thêm một loại sân mới hoặc một hạng khách mới chỉ cần viết thêm một lớp con, không phải sửa lại những lớp đang chạy tốt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="60" y="1759" width="800" height="350" as="geometry" />
        </mxCell>
        <mxCell id="P2_C" value="&lt;b&gt;CÔNG THỨC TÍNH PHÍ — Lớp FieldPricing (final, hàm khởi tạo private)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Khung giờ cao điểm:&lt;/b&gt; PEAK_START = 17:00 &amp;nbsp;|&amp;nbsp; PEAK_END = 20:00 &amp;nbsp;|&amp;nbsp; PEAK_SURCHARGE_RATE = 0.20&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Phí riêng theo loại sân:&lt;/b&gt;&lt;br/&gt;FOOTBALL_NIGHT_LIGHT_FEE = 50.000&lt;br/&gt;BADMINTON_RACKET_FEE = 20.000 &amp;nbsp;|&amp;nbsp; BADMINTON_MAT_FEE = 10.000&lt;br/&gt;TENNIS_EQUIPMENT_FEE = 40.000 &amp;nbsp;|&amp;nbsp; PICKLEBALL_EQUIPMENT_FEE_PER_HOUR = 15.000&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Công thức ghi đè trong từng lớp con:&lt;/b&gt;&lt;br/&gt;Sân bóng đá &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= basePricePerHour × giờ + 50.000&lt;br/&gt;Sân cầu lông = basePricePerHour × giờ + 20.000 + 10.000&lt;br/&gt;Sân tennis &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;= basePricePerHour × giờ + 40.000&lt;br/&gt;Sân pickleball = (basePricePerHour + 15.000) × giờ&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Phí cao điểm&lt;/b&gt; = basePricePerHour × giờ × 0.20, chỉ áp dụng khi 17:00 ≤ giờ bắt đầu &amp;lt; 20:00&lt;br/&gt;&lt;b&gt;Tổng tiền&lt;/b&gt; = phí thuê sân + phí cao điểm + phí dịch vụ − ưu đãi&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Ví dụ kiểm chứng&lt;/b&gt; (lượt đặt B001, khách VIP giảm 10%):&lt;br/&gt;200.000 + 40.000 + 30.000 − 27.000 = &lt;b&gt;243.000 đồng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="900" y="1759" width="770" height="350" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
