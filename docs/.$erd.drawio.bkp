        <mxCell id="R5" edge="1" parent="1" source="E_BADMINTON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#82b366;dashed=1;endArrow=none;fontSize=10;fontColor=#5b7c3a;labelBackgroundColor=#ffffff;" target="E_SERVICE" value="Dụng cụ vợt cho thuê tại sân cầu lông   —   —">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="P1_DATA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" value="&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;QUY MÔ DỮ LIỆU MẪU CHO CÁC THỰC THỂ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;CUSTOMER — 6 khách&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;3 khách STANDARD và 3 khách VIP&lt;br&gt;&lt;br&gt;&lt;b&gt;SPORTFIELD — 6 sân&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;2 sân bóng đá, 2 sân cầu lông,&lt;br&gt;&amp;nbsp;&amp;nbsp;1 sân tennis, 1 sân pickleball&lt;br&gt;&amp;nbsp;&amp;nbsp;→ chia đều vào 4 bảng loại sân&lt;br&gt;&lt;br&gt;&lt;b&gt;SERVICE — 6 dịch vụ&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;có 1 dịch vụ đang tạm ngưng&lt;br&gt;&lt;br&gt;&lt;b&gt;BOOKING — 12 lượt đặt&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;đủ ba trạng thái, có lượt vào&lt;br&gt;&amp;nbsp;&amp;nbsp;giờ cao điểm lẫn ngoài giờ cao&lt;br&gt;&amp;nbsp;&amp;nbsp;điểm, có lượt không kèm dịch vụ&lt;br&gt;&lt;br&gt;&lt;b&gt;INVOICE — 12 hóa đơn&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;6 đã trả, 4 chưa trả, 2 đã hoàn" vertex="1">
          <mxGeometry height="380" width="480" x="1380" y="890" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d2" name="2. ER → Lớp Java OOP">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="P2_TITLE" value="CHUYỂN CÁC QUAN HỆ ER / RR THÀNH CÁC LỚP TRONG PROJECT JAVA" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="45" width="1600" height="46" as="geometry" />
        </mxCell>
        <mxCell id="P2_SUB" value="Bước 2 của đặc tả. Chín bảng trong ERD trở thành mười lăm lớp trong thư mục &lt;b&gt;src/smartsporthub&lt;/b&gt; của project IntelliJ IDEA. Bảng ánh xạ bên dưới là bản đối chiếu giữa hai hình thức tổ chức dữ liệu của cùng một nghiệp vụ." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;fontColor=#444444;lineHeight=1.35;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="1600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="T1" value="&lt;b&gt;Bảng ER → một lớp&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Tên lớp viết hoa chữ cái đầu, không dấu gạch.&lt;br/&gt;Đặt trong thư mục &lt;b&gt;model/&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="60" y="165" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="T2" value="&lt;b&gt;Quan hệ RR → tham chiếu&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Không tạo bảng liên kết riêng.&lt;br/&gt;Lớp giữ &lt;b&gt;thuộc tính tham chiếu&lt;/b&gt; tới lớp kia." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="650" y="165" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="T3" value="&lt;b&gt;Thuộc tính khóa → bất biến&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Khai báo &lt;b&gt;private final&lt;/b&gt;.&lt;br/&gt;Không có hàm thiết lập cho thuộc tính khóa." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="165" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="T4" value="&lt;b&gt;Thuộc tính enum → java enum&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Tách thành &lt;b&gt;kiểu enum&lt;/b&gt; trong model/.&lt;br/&gt;Dùng để kiểm tra giá trị hợp lệ." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="T5" value="&lt;b&gt;Quan hệ kế thừa → lớp trừu tượng&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Bảng gốc thành &lt;b&gt;lớp trừu tượng&lt;/b&gt;, mỗi bảng con thành &lt;b&gt;một lớp con&lt;/b&gt; ghi đè phương thức trừu tượng." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="650" y="330" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="T6" value="&lt;b&gt;Nhóm thao tác CRUD → lớp quản lý&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Mỗi thực thể gốc có một &lt;b&gt;manager&lt;/b&gt; riêng trong manager/, giữ danh sách kiểu List." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#eef4ff;strokeColor=#6c8ebf;fontSize=12;spacing=12;fontColor=#1a1a1a;lineHeight=1.4;" vertex="1" parent="1">
          <mxGeometry x="1240" y="330" width="560" height="150" as="geometry" />
        </mxCell>
        <mxCell id="P2_M_TITLE" value="BẢNG ÁN XẠC: 9 BẢNG ER  →  15 LỚP JAVA" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="1600" height="32" as="geometry" />
